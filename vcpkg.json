{
  "name": "ithax",
  "version": "0.1.0",
  "description": "Ithax — multicore EVE Online open source client",
  "homepage": "https://github.com/Metalica/Ithax",
  "license": "MIT AND LicenseRef-PolyForm-Noncommercial-1.0.0",
  "dependencies": [
    {
      "name": "carbon-core",
      "version>=": "3.0.1"
    },
    {
      "name": "carbon-math",
      "version>=": "1.2.1"
    },
    {
      "name": "carbon-scheduler",
      "version>=": "1.4.3"
    },
    {
      "name": "carbon-io",
      "version>=": "1.3.1"
    },
    {
      "name": "carbon-blue",
      "version>=": "6.0.0"
    },
    {
      "name": "carbon-mesh",
      "version>=": "1.0.1"
    },
    {
      "name": "carbon-imageio",
      "version>=": "2.0.6"
    },
    {
      "name": "carbon-resources",
      "version>=": "4.3.2"
    },
    {
      "name": "carbon-trinity",
      "version>=": "4.0.2"
    },
    {
      "name": "carbon-destiny",
      "version>=": "3.1.1"
    },
    {
      "name": "carbon-audio",
      "version>=": "8.1.1"
    },
    {
      "name": "carbon-exefile",
      "version>=": "4.1.1"
    },
    {
      "name": "carbon-pathfinder",
      "version>=": "3.0.1"
    },
    {
      "name": "carbon-localization",
      "version>=": "2.2.1#1"
    },
    {
      "name": "carbon-db",
      "version>=": "2.3.1#2"
    },
    {
      "name": "carbon-parser",
      "version>=": "1.0.2"
    },
    {
      "name": "carbon-geo2",
      "version>=": "2.1.2"
    },
    {
      "name": "carbon-d3dinfo",
      "version>=": "2.0.2#1"
    },
    {
      "name": "taskflow",
      "version>=": "4.1.0"
    },
    {
      "name": "entt",
      "version>=": "3.16.0"
    },
    {
      "name": "tbb",
      "version>=": "2023.1.0"
    },
    {
      "name": "tracy",
      "version>=": "0.13.1#1"
    }
  ],
  "features": {
    "carbon-grpc": {
      "description": "Enable the experimental Carbon gRPC module",
      "dependencies": ["carbon-grpc"]
    },
    "trinity-shader-compiler": {
      "description": "Enable the optional Carbon Trinity shader compiler",
      "dependencies": [
        {
          "name": "carbon-trinity",
          "features": ["shader-compiler"]
        }
      ]
    },
    "trinity-vulkan": {
      "description": "Enable the Ithax TrinityAL Vulkan backend",
      "dependencies": [
        {
          "name": "carbon-trinity",
          "features": ["vulkan"]
        }
      ]
    },
    "wwise": {
      "description": "Enable the separately licensed Wwise SDK boundary",
      "dependencies": ["wwise"]
    },
    "vendor-sdks": {
      "description": "Enable the optional 3Dconnexion vendor SDK boundary",
      "dependencies": ["3dxwaresdk-win"]
    }
  },
  "overrides": [
    {
      "name": "libsquish",
      "version": "1.15#15"
    },
    {
      "name": "libpng",
      "version": "1.6.58"
    },
    {
      "name": "grpc",
      "version": "1.41.0"
    }
  ]
}
