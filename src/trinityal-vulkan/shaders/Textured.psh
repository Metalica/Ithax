Texture2D diffuse : register(t0);
SamplerState linearSampler : register(s0);

struct VSOut
{
	float4 position : SV_Position;
	float3 color : COLOR0;
	float2 uv : TEXCOORD0;
};

float4 main( VSOut input ) : SV_Target
{
	float3 texColor = diffuse.Sample( linearSampler, input.uv ).rgb;
	return float4( texColor * input.color, 1.0f );
}
